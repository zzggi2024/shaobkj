+def _catalog_media_capability(model_id: str, info: dict) -> bool:
+    modality_keys = ("inputModalities", "input_modalities")
+    for key in modality_keys:
+        modalities = info.get(key)
+        if modalities is None:
+            continue
+        values = modalities if isinstance(modalities, (list, tuple, set)) else [modalities]
+        return any(
+            marker in str(value).casefold()
+            for value in values
+            for marker in ("image", "vision", "video")
+        )
+
+    capabilities = info.get("capabilities")
+    if isinstance(capabilities, dict):
+        for key in ("vision", "image_input", "imageInput", "multimodal"):
+            if key in capabilities:
+                return bool(capabilities[key])
+    return _known_api_media_capability(model_id)
+
+
+def _known_api_media_capability(model_id: str) -> bool:
+    normalized = model_id.casefold()
+    return normalized.startswith(("gemini-", "gpt-4o", "gpt-4.1", "gpt-5"))
+
+
+def _api_supports_media(model_id: str) -> bool:
+    return _API_MEDIA_CAPABILITIES.get(
+        model_id, _known_api_media_capability(model_id)
+    )
 
 
