diff --git a/prompt_enhancer_models.py b/prompt_enhancer_models.py
new file mode 100644
index 0000000..15f70df
--- /dev/null
+++ b/prompt_enhancer_models.py
@@ -0,0 +1,225 @@
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal, Sequence
+
+try:
+    import folder_paths
+except ImportError:
+    folder_paths = None
+
+from .api_utils import DEFAULT_API_BASE, load_filtered_models
+from .prompt_enhancer_types import ChannelType, FeatureType, ModelSelectionError
+
+
+@dataclass(frozen=True)
+class LocalModel:
+    model_path: Path
+    relative_path: str
+    mmproj_path: Path | None
+    vision_capable: bool
+
+
+@dataclass(frozen=True)
+class ResolvedModel:
+    channel: Literal["local", "api"]
+    display_name: str
+    model_id: str | None
+    model_path: Path | None
+    mmproj_path: Path | None
+
+
+def _is_mmproj(path: Path) -> bool:
+    name = path.name.casefold()
+    return any(marker in name for marker in ("mmproj", "projector", "vision-proj"))
+
+
+def _model_tokens(path: Path) -> set[str]:
+    stem = path.stem.casefold()
+    stem = re.sub(r"mmproj|projector|vision-proj", " ", stem)
+    tokens = set(re.findall(r"[a-z0-9]+", stem))
+    return {
+        token
+        for token in tokens
+        if not re.fullmatch(r"(?:q|iq|f|bf|fp)\d+(?:_[a-z0-9]+)?", token)
+        and token not in {"k", "m", "s", "l", "xs", "xxs", "xl", "gguf"}
+    }
+
+
+def _matching_projector(model_path: Path, projectors: Sequence[Path]) -> Path | None:
+    candidates = [path for path in projectors if path.parent == model_path.parent]
+    if not candidates:
+        return None
+    if len(candidates) == 1:
+        return candidates[0]
+
+    model_tokens = _model_tokens(model_path)
+    scores = {
+        path: len(model_tokens & _model_tokens(path))
+        for path in candidates
+    }
+    highest_score = max(scores.values())
+    best = [path for path, score in scores.items() if score == highest_score]
+    if highest_score > 0 and len(best) == 1:
+        return best[0]
+    return None
+
+
+def _describe_model(
+    model_path: Path, model_root: Path, projectors: Sequence[Path]
+) -> LocalModel:
+    mmproj_path = _matching_projector(model_path, projectors)
+    return LocalModel(
+        model_path=model_path,
+        relative_path=model_path.relative_to(model_root).as_posix(),
+        mmproj_path=mmproj_path,
+        vision_capable=mmproj_path is not None,
+    )
+
+
+def _default_model_root() -> Path | None:
+    models_dir = getattr(folder_paths, "models_dir", None)
+    if not models_dir:
+        return None
+    return Path(models_dir) / "LLM"
+
+
+def scan_local_models(root: Path | None = None) -> list[LocalModel]:
+    model_root = (root or _default_model_root())
+    if model_root is None:
+        return []
+    model_root = model_root.resolve()
+    if not model_root.is_dir():
+        return []
+
+    files = sorted(
+        (path.resolve() for path in model_root.rglob("*.gguf") if path.is_file()),
+        key=lambda path: path.as_posix(),
+    )
+    safe_files = [path for path in files if path.is_relative_to(model_root)]
+    projectors = [path for path in safe_files if _is_mmproj(path)]
+    return [
+        _describe_model(path, model_root, projectors)
+        for path in safe_files
+        if not _is_mmproj(path)
+    ]
+
+
+def _is_text_generation_model(name: str, info: dict, api_style: str) -> bool:
+    model_name = str(name).casefold()
+    excluded_markers = ("embedding", "tts", "text-to-speech", "video", "sora")
+    if any(marker in model_name for marker in excluded_markers):
+        return False
+    if api_style == "gemini":
+        methods = info.get("supportedGenerationMethods", [])
+        return "generateContent" in methods
+    return api_style == "openai" and "image" not in model_name
+
+
+def discover_api_models(api_key: str) -> list[str]:
+    key = str(api_key or "").strip()
+    if not key:
+        return []
+    return load_filtered_models(
+        cache_prefix="multi_prompt_enhancer",
+        api_key=key,
+        api_base=DEFAULT_API_BASE,
+        use_proxy=False,
+        predicate=_is_text_generation_model,
+    )
+
+
+def model_option_labels(
+    local_models: Sequence[LocalModel], api_models: Sequence[str]
+) -> list[str]:
+    local_labels = [
+        f"[本地] {model.relative_path}"
+        for model in sorted(local_models, key=lambda item: item.relative_path)
+    ]
+    api_labels = [f"[API] {model_id}" for model_id in sorted(api_models)]
+    return ["智能选择", *local_labels, *api_labels]
+
+
+def _requires_vision_projector(feature: FeatureType, has_media: bool) -> bool:
+    return has_media and feature != "Music 3"
+
+
+def _local_is_compatible(
+    model: LocalModel, feature: FeatureType, has_media: bool
+) -> bool:
+    return not _requires_vision_projector(feature, has_media) or model.vision_capable
+
+
+def _resolved_local(model: LocalModel) -> ResolvedModel:
+    return ResolvedModel(
+        channel="local",
+        display_name=f"[本地] {model.relative_path}",
+        model_id=None,
+        model_path=model.model_path,
+        mmproj_path=model.mmproj_path,
+    )
+
+
+def _resolved_api(model_id: str) -> ResolvedModel:
+    return ResolvedModel(
+        channel="api",
+        display_name=f"[API] {model_id}",
+        model_id=model_id,
+        model_path=None,
+        mmproj_path=None,
+    )
+
+
+def _selected_local(selection: str, local_models: Sequence[LocalModel]) -> LocalModel | None:
+    if not selection.startswith("[本地] "):
+        return None
+    relative_path = selection.removeprefix("[本地] ")
+    return next(
+        (model for model in local_models if model.relative_path == relative_path), None
+    )
+
+
+def _selected_api(selection: str, api_models: Sequence[str]) -> str | None:
+    if not selection.startswith("[API] "):
+        return None
+    model_id = selection.removeprefix("[API] ")
+    return model_id if model_id in api_models else None
+
+
+def resolve_model(
+    feature: FeatureType,
+    channel: ChannelType,
+    selection: str,
+    has_media: bool,
+    local_models: Sequence[LocalModel],
+    api_models: Sequence[str],
+) -> ResolvedModel:
+    local_model = _selected_local(selection, local_models)
+    api_model = _selected_api(selection, api_models)
+    is_manual_selection = selection != "智能选择"
+
+    if is_manual_selection and local_model is None and api_model is None:
+        raise ModelSelectionError("所选模型不在当前模型目录中。")
+    if local_model is not None and channel == "API":
+        raise ModelSelectionError("所选本地模型与运行渠道不一致。")
+    if api_model is not None and channel == "本地模型":
+        raise ModelSelectionError("所选 API 模型与运行渠道不一致。")
+    if local_model is not None:
+        if not _local_is_compatible(local_model, feature, has_media):
+            raise ModelSelectionError("携带素材时，本地模型需要匹配的视觉投影器。")
+        return _resolved_local(local_model)
+    if api_model is not None:
+        return _resolved_api(api_model)
+
+    compatible_locals = [
+        model
+        for model in sorted(local_models, key=lambda item: item.relative_path)
+        if _local_is_compatible(model, feature, has_media)
+    ]
+    if channel in ("自动", "本地模型") and compatible_locals:
+        return _resolved_local(compatible_locals[0])
+    if channel in ("自动", "API") and api_models:
+        return _resolved_api(sorted(api_models)[0])
+    if channel == "本地模型" and _requires_vision_projector(feature, has_media):
+        raise ModelSelectionError("携带素材时，本地模型需要匹配的视觉投影器。")
+    raise ModelSelectionError("没有可用于当前运行渠道的兼容模型。")
