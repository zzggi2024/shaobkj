+import importlib
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+
+PROJECT_ROOT = Path(__file__).resolve().parent
+
+
+def load_models_module(models_dir: Path):
+    folder_paths = types.ModuleType("folder_paths")
+    folder_paths.models_dir = str(models_dir)
+    sys.modules["folder_paths"] = folder_paths
+
+    package = types.ModuleType("shaobkj")
+    package.__path__ = [str(PROJECT_ROOT)]
+    sys.modules["shaobkj"] = package
+    for name in (
+        "shaobkj.prompt_enhancer_models",
+        "shaobkj.prompt_enhancer_types",
+        "shaobkj.api_utils",
+    ):
+        sys.modules.pop(name, None)
+    return importlib.import_module("shaobkj.prompt_enhancer_models")
+
+
+def write_gguf(path: Path) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(b"GGUF")
+
+
+class PromptEnhancerModelTests(unittest.TestCase):
+    def setUp(self):
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp_dir.cleanup)
+        self.root = Path(self.temp_dir.name) / "LLM"
+        self.models = load_models_module(self.root.parent)
+        self.text_model = self.models.LocalModel(
+            self.root / "model.gguf", "model.gguf", None, False
+        )
+
+    def test_scan_recurses_and_distinguishes_duplicate_names(self):
+        write_gguf(self.root / "a" / "model.gguf")
+        write_gguf(self.root / "b" / "model.gguf")
+
+        labels = [item.relative_path for item in self.models.scan_local_models(self.root)]
+
+        self.assertEqual(labels, ["a/model.gguf", "b/model.gguf"])
+
+    def test_scan_uses_dynamic_llm_root_and_pairs_matching_projector(self):
+        write_gguf(self.root / "vision-model-Q4_K_M.gguf")
+        projector = self.root / "vision-model-mmproj-Q4_K_M.gguf"
+        write_gguf(projector)
+
+        models = self.models.scan_local_models()
+
+        self.assertEqual(len(models), 1)
+        self.assertEqual(models[0].model_path.name, "vision-model-Q4_K_M.gguf")
+        self.assertEqual(models[0].mmproj_path, projector.resolve())
+        self.assertTrue(models[0].vision_capable)
+
+    def test_scan_returns_empty_when_comfy_model_root_is_unavailable(self):
+        del self.models.folder_paths.models_dir
+
+        self.assertEqual(self.models.scan_local_models(), [])
+
+    def test_scan_does_not_guess_ambiguous_projector(self):
+        write_gguf(self.root / "model.gguf")
+        write_gguf(self.root / "model-mmproj-a.gguf")
+        write_gguf(self.root / "model-projector-b.gguf")
+
+        models = self.models.scan_local_models(self.root)
+
+        self.assertIsNone(models[0].mmproj_path)
+        self.assertFalse(models[0].vision_capable)
+
+    def test_discover_api_models_skips_network_without_key(self):
+        with patch.object(self.models, "load_filtered_models") as discovery:
+            self.assertEqual(self.models.discover_api_models("  "), [])
+
+        discovery.assert_not_called()
+
+    def test_discover_api_models_uses_direct_filtered_catalog(self):
+        with patch.object(
+            self.models, "load_filtered_models", return_value=["gpt-x"]
+        ) as discovery:
+            self.assertEqual(self.models.discover_api_models("key"), ["gpt-x"])
+
+        kwargs = discovery.call_args.kwargs
+        self.assertEqual(kwargs["cache_prefix"], "multi_prompt_enhancer")
+        self.assertEqual(kwargs["api_key"], "key")
+        self.assertEqual(kwargs["api_base"], self.models.DEFAULT_API_BASE)
+        self.assertFalse(kwargs["use_proxy"])
+        self.assertTrue(kwargs["predicate"]("gemini-2.5-flash", {"supportedGenerationMethods": ["generateContent"]}, "gemini"))
+        self.assertTrue(kwargs["predicate"]("gpt-x", {}, "openai"))
+        self.assertFalse(kwargs["predicate"]("text-embedding-3-small", {}, "openai"))
+        self.assertFalse(kwargs["predicate"]("gpt-image-2", {}, "openai"))
+        self.assertFalse(kwargs["predicate"]("gemini-image", {"supportedGenerationMethods": ["generateImages"]}, "gemini"))
+
+    def test_model_option_labels_sort_by_source_and_name(self):
+        local_models = [
+            self.models.LocalModel(self.root / "z.gguf", "z.gguf", None, False),
+            self.models.LocalModel(self.root / "a.gguf", "a.gguf", None, False),
+        ]
+
+        labels = self.models.model_option_labels(local_models, ["z-api", "a-api"])
+
+        self.assertEqual(
+            labels,
+            ["智能选择", "[本地] a.gguf", "[本地] z.gguf", "[API] a-api", "[API] z-api"],
+        )
+
+    def test_visual_task_requires_matching_mmproj(self):
+        with self.assertRaisesRegex(self.models.ModelSelectionError, "视觉投影器"):
+            self.models.resolve_model(
+                "H3", "本地模型", "[本地] model.gguf", True, [self.text_model], []
+            )
+
+    def test_music_three_never_requires_mmproj(self):
+        resolved = self.models.resolve_model(
+            "Music 3", "本地模型", "[本地] model.gguf", True, [self.text_model], []
+        )
+
+        self.assertEqual(resolved.channel, "local")
+        self.assertEqual(resolved.model_path, self.text_model.model_path)
+
+    def test_auto_prefers_compatible_local_then_api(self):
+        local = self.models.resolve_model(
+            "Music 3", "自动", "智能选择", False, [self.text_model], ["gpt-x"]
+        )
+        api = self.models.resolve_model(
+            "H3", "自动", "智能选择", True, [self.text_model], ["gpt-x"]
+        )
+
+        self.assertEqual(local.channel, "local")
+        self.assertEqual(api.channel, "api")
+
+    def test_manual_selection_has_priority_and_channel_must_agree(self):
+        resolved = self.models.resolve_model(
+            "H3", "自动", "[API] gpt-x", False, [self.text_model], ["gpt-x"]
+        )
+        self.assertEqual(resolved.model_id, "gpt-x")
+
+        with self.assertRaisesRegex(self.models.ModelSelectionError, "运行渠道"):
+            self.models.resolve_model(
+                "H3", "API", "[本地] model.gguf", False, [self.text_model], ["gpt-x"]
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
