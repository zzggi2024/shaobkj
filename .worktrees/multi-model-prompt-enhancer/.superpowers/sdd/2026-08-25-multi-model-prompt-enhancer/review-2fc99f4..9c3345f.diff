+++ b/test_multi_prompt_enhancer_contract.py
@@ -0,0 +1,89 @@
+import importlib
+import sys
+import types
+import unittest
+from pathlib import Path
+
+
+PROJECT_ROOT = Path(__file__).resolve().parent
+
+
+def load_module_with_comfy_stubs(filename):
+    package = types.ModuleType("shaobkj")
+    package.__path__ = [str(PROJECT_ROOT)]
+    sys.modules["shaobkj"] = package
+    module_name = f"shaobkj.{Path(filename).stem}"
+    sys.modules.pop(module_name, None)
+    return importlib.import_module(module_name)
+
+
+class MultiPromptEnhancerContractTests(unittest.TestCase):
+    def test_new_node_is_registered_and_old_prompt_node_is_absent(self):
+        source = (PROJECT_ROOT / "nodes.py").read_text(encoding="utf-8")
+        self.assertIn('"Shaobkj_Multi_Prompt_Enhancer"', source)
+        self.assertNotIn('"Shaobkj_H3_Video_Prompt"', source)
+        self.assertIn('"Shaobkj_H3_Video"', source)
+
+    def test_node_has_fixed_public_contract(self):
+        module = load_module_with_comfy_stubs("node_multi_prompt_enhancer.py")
+        node = module.Shaobkj_Multi_Prompt_Enhancer
+        inputs = node.INPUT_TYPES()
+        required = inputs["required"]
+        self.assertEqual(
+            list(required)[:7],
+            [
+                "功能类型",
+                "运行渠道",
+                "模型选择",
+                "API密钥",
+                "创作需求",
+                "输出语言",
+                "随机种",
+            ],
+        )
+        self.assertEqual(required["功能类型"][0], ["H3", "Seedance", "Music 3"])
+        self.assertEqual(required["运行渠道"][0], ["自动", "本地模型", "API"])
+        self.assertEqual(required["模型选择"][0][0], "智能选择")
+        self.assertEqual(required["API密钥"][1]["default"], "")
+        self.assertTrue(required["创作需求"][1]["multiline"])
+        self.assertEqual(required["输出语言"][0], ["自动", "中文", "English", "日本語", "한국어"])
+        self.assertEqual(required["随机种"][1], {"default": 0, "min": 0, "max": 2147483647})
+        self.assertEqual(required["生成模式"][0], ["自动", "T2VA", "I2VA", "FL2VA", "L2VA", "Ref2VA"])
+        self.assertEqual(required["目标时长"][0], ["自动", *[f"{second}秒" for second in range(1, 301)]])
+        self.assertEqual(required["BPM"][0], ["自动", *[str(bpm) for bpm in range(40, 241)]])
+        self.assertEqual(required["原生音频"][0], "BOOLEAN")
+        self.assertEqual(
+            inputs["optional"],
+            {
+                "首帧图": ("IMAGE",),
+                "尾帧图": ("IMAGE",),
+                "参考图片1": ("IMAGE",),
+                "参考视频1": ("VIDEO",),
+                "参考音频1": ("AUDIO",),
+            },
+        )
+        self.assertEqual(node.RETURN_TYPES, ("STRING",))
+        self.assertEqual(node.RETURN_NAMES, ("最终提示词",))
+        self.assertEqual(node.FUNCTION, "generate_prompt")
+        self.assertEqual(node.CATEGORY, "🤖shaobkj-APlbox")
+
+    def test_node_reports_its_unwired_execution_boundary(self):
+        module = load_module_with_comfy_stubs("node_multi_prompt_enhancer.py")
+        with self.assertRaisesRegex(
+            module.PromptEnhancerError, "多模型提示词增强器尚未完成执行接线"
+        ):
+            module.Shaobkj_Multi_Prompt_Enhancer().generate_prompt()
+
+    def test_shared_types_have_frozen_defaults_and_provider_contract(self):
+        types_module = load_module_with_comfy_stubs("prompt_enhancer_types.py")
+        media = types_module.MediaBundle()
+        request = types_module.GenerationRequest("system", "user")
+        self.assertEqual((media.images, media.videos, media.audios), ((), (), ()))
+        self.assertEqual(request.image_data_uris, ())
+        self.assertEqual((request.seed, request.temperature, request.max_tokens), (0, 0.4, 8192))
+        self.assertTrue(issubclass(types_module.ProviderError, types_module.PromptEnhancerError))
+        self.assertEqual(types_module.TextProvider.generate.__annotations__["return"], str)
+
+
+if __name__ == "__main__":
+    unittest.main()
