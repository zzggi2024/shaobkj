@@ -0,0 +1,58 @@
+from dataclasses import dataclass
+from typing import Any, Literal, Protocol, Sequence
+
+
+FeatureType = Literal["H3", "Seedance", "Music 3"]
+ChannelType = Literal["自动", "本地模型", "API"]
+
+
+@dataclass(frozen=True)
+class MediaItem:
+    name: str
+    value: Any
+
+
+@dataclass(frozen=True)
+class MediaBundle:
+    images: Sequence[MediaItem] = ()
+    videos: Sequence[MediaItem] = ()
+    audios: Sequence[MediaItem] = ()
+
+
+@dataclass(frozen=True)
+class GenerationRequest:
+    system_prompt: str
+    user_prompt: str
+    image_data_uris: Sequence[str] = ()
+    seed: int = 0
+    temperature: float = 0.4
+    max_tokens: int = 8192
+
+
+class PromptEnhancerError(RuntimeError):
+    """Base error safe to show in ComfyUI."""
+
+
+class ModelSelectionError(PromptEnhancerError):
+    """Selected channel/model cannot satisfy the task."""
+
+
+class RuntimeInstallError(PromptEnhancerError):
+    """Pinned local runtime could not be prepared."""
+
+
+class LocalPreparationError(PromptEnhancerError):
+    """Local device or server failed before the inference POST."""
+
+
+class ProviderError(PromptEnhancerError):
+    """One model request failed or returned no text."""
+
+
+class CompilerOutputError(PromptEnhancerError):
+    """Nonempty provider output violates a hard protocol invariant."""
+
+
+class TextProvider(Protocol):
+    def generate(self, request: GenerationRequest) -> str:
+        raise NotImplementedError
